<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Company>OxCore</Company>
		<Title>OxCore Quantum Queue</Title>
		<Authors>Prabuddha Jayawardhana</Authors>
		<Product>OxCore.QuantumQueue.Core</Product>
		<PackageId>OxCore.QuantumQueue.Core</PackageId>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>QuantumQueue.jpg</PackageIcon>
		<NeutralLanguage>en-001</NeutralLanguage>
		<Version>9.0.0</Version>
		<AssemblyVersion>9.0.0</AssemblyVersion>
		<FileVersion>9.0.0</FileVersion>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<ProduceReferenceAssembly>true</ProduceReferenceAssembly>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<IncludeSymbols>false</IncludeSymbols>
		<IncludeSource>false</IncludeSource>
		<DebugType>none</DebugType>
		<EnableDefaultItems>false</EnableDefaultItems>
	</PropertyGroup>

	<ItemGroup>
	  <Compile Include="DependencyInjection.cs" />
	  <Compile Include="Dto\Scheduler\ScheduledJobDto.cs" />
	  <Compile Include="Extensions\JobSchedulerExtensions.cs" />
	  <Compile Include="Services\Scheduler\IJob.cs" />
	  <Compile Include="Services\Scheduler\IJobScheduler.cs" />
	  <Compile Include="Services\Scheduler\Implementation\CronJobScheduler.cs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="9.0.4" />
		<PackageReference Include="OxCore.QuantumQueue.SharedKernel" Version="9.0.0" />
	</ItemGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
		<None Include="..\..\..\Icon\QuantumQueue.jpg" Link="Icon\QuantumQueue.jpg">
		  <Pack>True</Pack>
		  <PackagePath>\</PackagePath>
		</None>
		<None Include="..\..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Icon\" />
	</ItemGroup>

</Project>
